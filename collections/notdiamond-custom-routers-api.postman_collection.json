        {
          "id": "bb4ff7fe-9343-4a38-b47e-73f3511678cc",
          "name": "Train a custom router.",
          "request": {
            "name": "Train a custom router.",
            "description": {
              "content": "Trains a custom router from an uploaded CSV evaluation dataset. Training is asynchronous and typically takes 5-15 minutes. Returns a preference ID used to drive personalized routing in subsequent modelSelect calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pzn",
                "trainCustomRouter"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "dataset_file",
                  "type": "file",
                  "description": "(Required) CSV file with evaluation data (minimum 25 samples)."
                },
                {
                  "key": "language",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required)  (This can only be one of english,multilingual)"
                },
                {
                  "key": "llm_providers",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) JSON array of model providers."
                },
                {
                  "key": "prompt_column",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) CSV column name containing prompts."
                },
                {
                  "key": "maximize",
                  "value": "<boolean>",
                  "type": "text",
                  "description": "(Required) Whether higher scores indicate better performance."
                },
                {
                  "key": "preference_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "Existing router ID to update."
                },
                {
                  "key": "override",
                  "value": "true",
                  "type": "text",
                  "description": "Override existing router."
                }
              ]
            }
          },
