          "name": "Route a prompt to the best model.",
          "request": {
            "name": "Route a prompt to the best model.",
            "description": {
              "content": "Given OpenAI-format messages and a list of candidate LLM providers, returns the recommended provider/model along with a session ID for the routing decision. Supports cost/latency tradeoffs and personalized routing via a preference ID.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "modelRouter",
                "modelSelect"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string>\"\n    },\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string>\"\n    }\n  ],\n  \"llm_providers\": [\n    {\n      \"model\": \"<string>\",\n      \"provider\": \"<string>\",\n      \"is_custom\": \"<boolean>\",\n      \"context_length\": \"<integer>\",\n      \"input_price\": \"<number>\",\n      \"output_price\": \"<number>\",\n      \"latency\": \"<number>\"\n    },\n    {\n      \"model\": \"<string>\",\n      \"provider\": \"<string>\",\n      \"is_custom\": \"<boolean>\",\n      \"context_length\": \"<integer>\",\n      \"input_price\": \"<number>\",\n      \"output_price\": \"<number>\",\n      \"latency\": \"<number>\"\n    }\n  ],\n  \"tools\": [\n    \"<object>\",\n    \"<object>\"\n  ],\n  \"preference_id\": \"<string>\",\n  \"tradeoff\": \"<string>\",\n  \"cost_quality_tradeoff\": \"<integer>\",\n  \"hash_content\": false,\n  \"metric\": \"accuracy\",\n  \"max_model_depth\": \"<integer>\",\n  \"previous_session\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
